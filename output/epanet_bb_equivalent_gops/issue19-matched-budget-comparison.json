  "cost_methodology": {
    "audit_effective_cost": "The EPANET-BB audit applies the GOPS commanded schedule to the EPANET-BB hydraulic evaluator, sums pump adjustedTotalCost values, and reports effective_cost_raw / 100 as effective_cost.",
